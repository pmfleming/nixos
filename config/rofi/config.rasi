configuration {
  modi: "drun,run,window";
  font: "@FONT_UI@, @FONT_ICONS@ @FONT_SIZE@";
  show-icons: true;
  display-drun: "apps";
  display-run: "run";
  display-window: "win";
  display-wifi: "wifi";
  display-bluetooth: "bt";
  display-clipboard: "paste";
}

* {
  background: rgba(@BG_RGB@, 82%);
  background-alt: rgba(@BG_RGB@, 88%);
  foreground: @FOREGROUND@;
  muted: @SUBTEXT@;
  accent: @ACCENT@;
  urgent: @DANGER@;
  border: @ACCENT@;
}

window {
  width: @ROFI_WIDTH@;
  border: 1px;
  border-color: @border;
  border-radius: @RADIUS@;
  background-color: @background;
}

mainbox {
  padding: 10px;
  spacing: 8px;
}

inputbar {
  padding: 8px;
  border-radius: @RADIUS@;
  background-color: @background-alt;
}

prompt {
  text-color: @accent;
  padding: 0 8px 0 0;
}

entry {
  text-color: @foreground;
}

listview {
  lines: @ROFI_LINES@;
  columns: 1;
  fixed-height: true;
  scrollbar: true;
  spacing: 4px;
}

scrollbar {
  handle-width: @SCROLLBAR_WIDTH@;
  handle-color: @accent;
  background-color: @background-alt;
  border-radius: @RADIUS@;
}

element {
  padding: 7px;
  border-radius: @RADIUS@;
  background-color: transparent;
  text-color: @foreground;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color: @foreground;
}

element normal.active,
element alternate.active {
  background-color: @background-alt;
  text-color: @foreground;
}

element normal.urgent,
element alternate.urgent {
  background-color: @background-alt;
  text-color: @urgent;
}

element selected.normal,
element selected.active,
element selected.urgent {
  background-color: @accent;
  text-color: @BLACK@;
}

element-icon {
  size: 18px;
  padding: 2px 6px;
  border: 1px;
  border-color: transparent;
  border-radius: @RADIUS@;
}

element-icon normal.active,
element-icon alternate.active {
  border-color: @accent;
}

element-icon selected.active {
  border-color: @BLACK@;
}

element-text {
  text-color: inherit;
}
/* git-hash-padding: 1 */
