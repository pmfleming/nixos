+fn is_fingerprint_auth_message(message: &str) -> bool {
+  let message = message.to_ascii_lowercase();
+
+  message.contains("fingerprint reader")
+    || message.contains("fingerprint")
+    || message.contains("finger across")
+    || message.contains("thumb across")
+    || message.contains("index finger")
+    || message.contains("middle finger")
+    || message.contains("ring finger")
+    || message.contains("little finger")
+}
